LLM_API_KEY=your_api_key_here
# 模型与接口地址（默认硅基流动 GLM-5.1；接入其他 OpenAI 兼容服务时覆盖这两项）
# LLM_MODEL_NAME=gpt-5.5
# LLM_BASE_URL=https://gpt.eacase.de5.net/v1
# 三项均支持逗号分隔多组供应商，按优先级自动降级（数量不足时循环复用）：
# LLM_MODEL_NAME=gpt-5.5,Pro/zai-org/GLM-5.1
# LLM_BASE_URL=https://gpt.eacase.de5.net/v1,https://api.siliconflow.cn/v1
# LLM_API_KEY=key_for_relay,key_for_siliconflow
# 单个供应商调用超时秒数（默认 180）
# LLM_TIMEOUT=180

# 数据库连接（不设置时默认 localhost:3306 didilili/dili123，即本地开发模式）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=didilili
# DB_PASSWORD=dili123
